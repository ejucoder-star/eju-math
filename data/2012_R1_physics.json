    {
      "id": "2012-r1-phys-10",
      "number": "II-C 问3",
      "topic": "绝热容器中定容与定压气体的热平衡",
      "topicTag": "热学·热力学第一定律",
      "questionType": "choice",
      "humanVerified": true,
      "answer_match": true,
      "needs_review": false,
      "japanese": "绝热容器内有单原子理想气体，被固定隔板分成定容空间 A 和带活塞的定压空间 B。B 中物质的量是 A 的 3 倍，初始温度分别为 $2T_0$ 与 $T_0$。足够长时间后两边温度都为 $T_1$，求 $T_1$。",
      "options": [
        {
          "label": "①",
          "content": "$\\dfrac54T_0$"
        },
        {
          "label": "②",
          "content": "$\\dfrac76T_0$"
        },
        {
          "label": "③",
          "content": "$\\dfrac{11}{8}T_0$"
        },
        {
          "label": "④",
          "content": "$\\dfrac72T_0$"
        }
      ],
      "questionImage": "/images/2012_R1_physics/q10.png",
      "solution": {
        "translation": "B 的活塞保持压强不变，因此 B 在温度变化时会对外做功；这一步不能忽略。",
        "analysis": "设 A 中物质的量为 $n$，则 B 为 $3n$。单原子理想气体内能 $U=\\frac32nRT$。总气体没有吸收外界热量，但 B 对外做功 $W=3nR(T_1-T_0)$。",
        "steps": [
          {
            "title": "写总能量关系",
            "content": "$$\\Delta U_A+\\Delta U_B=-W$$"
          },
          {
            "title": "代入各项",
            "content": "$$\\frac32nR(T_1-2T_0)+\\frac32(3n)R(T_1-T_0)=-3nR(T_1-T_0)$$"
          },
          {
            "title": "解出温度",
            "content": "$$3(T_1-2T_0)+9(T_1-T_0)=-6(T_1-T_0)$$\n\n$$18T_1=21T_0$$\n\n$$T_1=\\frac76T_0$$"
          }
        ],
        "finalAnswer": "② $\\dfrac76T_0$",
        "correctOption": "②"
      }
    },
