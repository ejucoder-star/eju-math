  "questions": [
    {
      "id": "2012-r1-phys-1",
      "number": "I-A 问1",
      "topic": "三物体接触运动中的作用力",
      "topicTag": "力学·牛顿运动定律",
      "questionType": "choice",
      "humanVerified": true,
      "answer_match": true,
      "needs_review": false,
      "japanese": "光滑水平面上有质量相等的 A、B、C 三个物体。用大小为 $F$ 的水平力推 A，三者保持接触一起运动。求 C 对 B 的水平作用力大小。",
      "options": [
        {
          "label": "①",
          "content": "$\\dfrac13F$"
        },
        {
          "label": "②",
          "content": "$\\dfrac12F$"
        },
        {
          "label": "③",
          "content": "$\\dfrac23F$"
        },
        {
          "label": "④",
          "content": "$F$"
        }
      ],
      "questionImage": "/images/2012_R1_physics/q01.png",
      "solution": {
        "translation": "先求三物体共同加速度，再单独看 C 的受力。",
        "analysis": "设每个物体质量为 $m$，整体质量为 $3m$。C 的加速度与整体相同，C 水平方向只靠 B 的推力加速。",
        "steps": [
          {
            "title": "(1) 求共同加速度",
            "content": "$$a=\\frac{F}{3m}$$"
          },
          {
            "title": "(2) 对 C 用牛顿第二定律",
            "content": "B 对 C 的力为\n\n$$F_{B\\to C}=ma=\\frac13F$$\n\n由作用力与反作用力，C 对 B 的力大小也为 $\\frac13F$。"
          }
        ],
        "finalAnswer": "① $\\dfrac13F$",
        "correctOption": "①"
      }
    },
    {
      "id": "2012-r1-phys-2",
      "number": "I-B 问2",
      "topic": "重力加速度改变时的抛体射程",
      "topicTag": "力学·抛体运动",
      "questionType": "choice",
      "humanVerified": true,
      "answer_match": true,
      "needs_review": false,
      "japanese": "某星球表面的重力加速度为地球的一半。用与地球上相同的初速度和抛射角斜向上抛出物体，比较从抛出点到落地点的水平距离。",
      "options": [
        {
          "label": "①",
          "content": "$\\dfrac14$"
        },
        {
          "label": "②",
          "content": "$\\dfrac12$"
        },
        {
          "label": "③",
          "content": "1"
        },
        {
          "label": "④",
          "content": "2"
        },
        {
          "label": "⑤",
          "content": "4"
        }
      ],
      "questionImage": "",
      "solution": {
        "translation": "射程公式中，初速度和角度相同，射程与重力加速度成反比。",
        "analysis": "斜抛运动在同一高度落回时，水平射程为 $R=v_0^2\\sin2\\theta/g$。星球上 $g^\\prime=g/2$。",
        "steps": [
          {
            "title": "比较射程",
            "content": "$$R^\\prime=\\frac{v_0^2\\sin2\\theta}{g/2}=2R$$"
          }
        ],
        "finalAnswer": "④ $2$",
        "correctOption": "④"
      }
    },
    {
      "id": "2012-r1-phys-3",
      "number": "I-C 问3",
      "topic": "滑轮连接物体的静摩擦力比较",
      "topicTag": "力学·受力平衡",
      "questionType": "choice",
      "humanVerified": true,
      "answer_match": true,
      "needs_review": false,
      "japanese": "质量为 $m$ 的 A 与质量为 $\\frac52m$ 的 B 由轻绳绕过光滑滑轮相连。A 所在面无摩擦，B 所在面有摩擦。图 1、图 2、图 3 三种静止情形中，B 受到的摩擦力大小分别为 $F_1,F_2,F_3$，比较大小。",
      "options": [
        {
          "label": "①",
          "content": "$F_1<F_2<F_3$"
        },
        {
          "label": "②",
          "content": "$F_1<F_3<F_2$"
        },
        {
          "label": "③",
          "content": "$F_2<F_1<F_3$"
        },
        {
          "label": "④",
          "content": "$F_2<F_3<F_1$"
        },
        {
          "label": "⑤",
          "content": "$F_3<F_1<F_2$"
        },
        {
          "label": "⑥",
          "content": "$F_3<F_2<F_1$"
        }
      ],
      "questionImage": "/images/2012_R1_physics/q03.png",
      "solution": {
        "translation": "先由 A 的平衡求绳张力，再分别对 B 沿接触面方向列平衡。",
        "analysis": "A 没有摩擦，所以绳张力由 A 沿面方向的重力分量决定：$T=mg\\sin\\theta$。B 的摩擦力负责补足 B 沿面方向受力的不平衡。",
        "steps": [
          {
            "title": "图 1",
            "content": "B 在水平面上，摩擦力平衡绳张力：\n\n$$F_1=T=mg\\sin\\theta$$"
          },
          {
            "title": "图 2",
            "content": "B 在另一斜面上，重力沿斜面向下，绳张力向上，且 B 较重：\n\n$$F_2=\\frac52mg\\sin\\theta-T=\\frac32mg\\sin\\theta$$"
          },
          {
            "title": "图 3",
            "content": "B 与绳张力、重力沿斜面的方向都使它趋向下滑，摩擦力需同时平衡二者：\n\n$$F_3=\\frac52mg\\sin\\theta+T=\\frac72mg\\sin\\theta$$"
          }
        ],
        "finalAnswer": "① $F_1<F_2<F_3$",
        "correctOption": "①"
      }
    },
    {
      "id": "2012-r1-phys-4",
      "number": "I-D 问4",
      "topic": "内部弹性碰撞导致容器间歇运动",
      "topicTag": "力学·动量守恒",
      "questionType": "choice",
      "humanVerified": true,
      "answer_match": true,
      "needs_review": false,
      "japanese": "质量 $M$ 的物体 A 放在光滑水平面上，质量 $m$ 的小物体 B 在 A 上方光滑面内运动并与 A 两端墙壁反复弹性碰撞。B 相对 A 的速度大小恒为 $v$，A 每隔 $T/2$ 交替静止和移动距离 $L$。求 $v$。",
      "options": [
        {
          "label": "①",
          "content": "$\\dfrac{2L}{T}$"
        },
        {
          "label": "②",
          "content": "$\\dfrac{4M}{M+m}\\cdot\\dfrac{L}{T}$"
        },
        {
          "label": "③",
          "content": "$\\dfrac{4m}{M+m}\\cdot\\dfrac{L}{T}$"
        },
        {
          "label": "④",
          "content": "$\\dfrac{M+m}{M}\\cdot\\dfrac{L}{T}$"
        },
        {
          "label": "⑤",
          "content": "$\\dfrac{M+m}{m}\\cdot\\dfrac{L}{T}$"
        }
      ],
      "questionImage": "/images/2012_R1_physics/q04.png",
      "solution": {
        "translation": "A 移动时图像斜率给出 A 的速度；碰撞瞬间用动量守恒连接这个速度和相对速度。",
        "analysis": "A 在移动的半个周期内走过 $L$，所以移动速度为 $U=2L/T$。某次碰撞前 A 静止、B 以速度 $v$ 运动；碰后 A 以 $U$ 运动，而 B 相对 A 反向，实验室速度为 $U-v$。",
        "steps": [
          {
            "title": "碰撞前后动量守恒",
            "content": "$$mv=MU+m(U-v)$$\n\n$$2mv=(M+m)U$$"
          },
          {
            "title": "代入 A 的速度",
            "content": "$$U=\\frac{2L}{T}$$\n\n$$v=\\frac{M+m}{2m}U=\\frac{M+m}{m}\\frac{L}{T}$$"
          }
        ],
        "finalAnswer": "⑤ $\\dfrac{M+m}{m}\\cdot\\dfrac{L}{T}$",
        "correctOption": "⑤"
      }
    },
    {
